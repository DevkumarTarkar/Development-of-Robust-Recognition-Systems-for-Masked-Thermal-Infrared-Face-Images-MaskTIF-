## Backend configuration (Flask)
# Do NOT commit real secrets; copy to ".env" for local use.

# Flask / JWT secrets
# Use long random strings (>= 32 chars recommended)
SECRET_KEY=change-this-secret-key-please-use-32chars+
JWT_SECRET_KEY=change-this-jwt-secret-please-use-32chars+

# Database
# For local: sqlite file will be used automatically if DATABASE_URL is empty.
# DATABASE_URL=sqlite:///backend/masktif.db

# CORS
# Comma-separated list of allowed origins for browser clients.
# Example for local Live Server + Vercel preview:
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Rate limiter storage
# For production you can set Render/Redis URL here.
# REDIS_URL=redis://localhost:6379/0

